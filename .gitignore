# ============================================================
# MevaCoin Wallet — .gitignore
# ============================================================
# CRITICO: Questo file impedisce che il keystore e altri file
# sensibili vengano committati nel repository pubblico.
# ============================================================


# ────────────────────────────────────────────────────────────
# KEYSTORE E CREDENZIALI — MAI committare nel repo
# ────────────────────────────────────────────────────────────
*.keystore
*.jks
*.p12
*.pfx
android-keystore/
keystore.properties
signing.properties
release.properties

# Google Play service account key
*.json
!package.json
!package-lock.json

# Variabili d'ambiente con credenziali
.env
.env.*
secrets.properties


# ────────────────────────────────────────────────────────────
# BUILD ARTIFACTS
# ────────────────────────────────────────────────────────────
build/
*.apk
*.aab
*.idsig
*.ap_
*.dex

# CMake build directories
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# Qt build artifacts
*.pro.user
*.pro.user.*
Makefile
.qmake.stash
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.qm

# Object files
*.o
*.obj
*.lo
*.slo
*.la
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll

# Executables
*.exe
*.out
*.app
*.ipa


# ────────────────────────────────────────────────────────────
# LOGS E FILE TEMPORANEI
# ────────────────────────────────────────────────────────────
*.log
build_log.txt
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini


# ────────────────────────────────────────────────────────────
# IDE
# ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
nbproject/


# ────────────────────────────────────────────────────────────
# DOCKER
# ────────────────────────────────────────────────────────────
# Non escludere i Dockerfile ma escludere artefatti Docker locali
.dockerignore.local


# ────────────────────────────────────────────────────────────
# NODE / NPM (se usati per build tools)
# ────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ────────────────────────────────────────────────────────────
# PYTHON
# ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/


# ────────────────────────────────────────────────────────────
# NOTE: File che devono restare nel repo
# ────────────────────────────────────────────────────────────
# I seguenti file NON devono essere in .gitignore:
# - Dockerfile.android, Dockerfile.linux, Dockerfile.windows
# - android/AndroidManifest.xml
# - android/res/ (icone e risorse)
# - privacy-policy.html (se la ospiti su GitHub Pages)
# - LICENSE
# - README.md
